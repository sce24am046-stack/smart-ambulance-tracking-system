# ResQ Pulse - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.

# Flask Environment: development, testing, or production
FLASK_ENV=development

# Application Secret Key (Generate a random 32-byte hex string in production: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# SQLite Database Path (relative to instance folder or absolute path)
DATABASE_PATH=resq_pulse.db

# Server Host & Port
PORT=5000
HOST=127.0.0.1

# Session Security (set to True when serving over HTTPS)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Smart Dispatch Parameters
ASSUMED_CITY_SPEED_KMH=40.0
STALE_LOCATION_THRESHOLD_MINUTES=15

# GPS API Key (Optional header key for location update endpoints)
GPS_TRACKER_API_KEY=resq-pulse-demo-gps-key

# ---------------------------------------------------------------------------
# Routing Provider Configuration
# ---------------------------------------------------------------------------
# ROUTING_PROVIDER: 'osrm' (default, free open-source road routing, no API key required)
#                   'mapbox' (traffic-aware if valid MAPBOX_API_KEY is supplied)
#                   'tomtom' (traffic-aware if valid TOMTOM_API_KEY is supplied)
#                   'offline' (straight-line fallback with assumed velocity)
ROUTING_PROVIDER=osrm

# API Key for optional third-party traffic-aware providers (leave blank for OSRM)
ROUTING_API_KEY=

# In-memory and database route calculation cache TTL in seconds (prevents duplicate API calls)
ROUTING_CACHE_TTL_SECONDS=300

# Radar Map polling interval in seconds
MAP_POLL_INTERVAL_SECONDS=4

# Minimum interval between consecutive location updates for a single ambulance (in seconds)
LOCATION_UPDATE_MIN_INTERVAL_SECONDS=2

# Public emergency tracking token expiration in hours
TRACKING_TOKEN_EXPIRY_HOURS=48
